# Used by deploy/ scripts and optional integration runs. Never commit a real .env.
# Network: studio-next (default, chain 61997) | localnet (61127)
MONOCLE_NETWORK=studio-next
# Canonical Studio Next RPC. studio-next.genlayer.com is the browser alias.
GENLAYER_RPC_URL=https://studio-dev.genlayer.com/api
# Either a raw key...
PRIVATE_KEY=
# ...or a GenLayer CLI keystore (decrypted in-process, never printed).
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
# Factory configuration (wei).
CREATION_STAKE_WEI=0
MIN_INTERPRETATION_BOND_WEI=1000000000000000
MIN_SOURCE_BOND_WEI=100000000000000
MIN_CHALLENGE_BOND_WEI=1000000000000000
# Challenge window (seconds) for every Monocle the factory creates.
# 3600 for real use; the public Studio Next demo deployment uses 180.
CHALLENGE_WINDOW_SECONDS=180
# Optional web-app override (Vercel env). The site already defaults to the
# factory in deploy/deployments.json via frontend/lib/deployment.ts; set this
# only to point a build elsewhere. Rebuild the site after changing it.
NEXT_PUBLIC_MONOCLE_FACTORY=0x6e9bfAd92A1a34310c29ce099C3bc83E2bAef48e
# Set to 1 to let integration tests wait out the 1h challenge window.
MONOCLE_INTEGRATION_LONG=0
